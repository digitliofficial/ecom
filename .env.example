# --- Database (Nest / FastAPI / workers) ---
# Use ecom_app (non-superuser) so Postgres RLS applies. Owner/superuser bypasses RLS.
DATABASE_URL=postgresql://ecom_app:ecom@localhost:5432/ecom
# Optional owner URL for migrations / break-glass
DATABASE_URL_ADMIN=postgresql://ecom:ecom@localhost:5432/ecom

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Required in production. Local/dev falls back to a fixed demo secret if empty.
JWT_SECRET=ecom-local-dev-jwt-secret-change-me

# --- Public URLs ---
# Storefront default: http://localhost:3005 (see apps/storefront package.json)
NEXT_PUBLIC_API_URL=http://localhost:3001
COMPUTE_URL=http://localhost:8000
DEFAULT_REGION=us
# CNAME target merchants point custom domains at (CDN/WAF edge; stub for local)
PLATFORM_CNAME_TARGET=edge.ecom.digitli.local

# --- Stripe (commerce — PaymentProvider / Connect) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (SaaS Billing — merchant subscriptions) ---
STRIPE_BILLING_SECRET_KEY=

# --- Email ---
RESEND_API_KEY=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=

# --- Shopify migration (per-merchant later → vault) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Address / courier adapters ---
ADDRESS_VALIDATION_API_KEY=
COURIER_API_KEY=

# --- Optional Turbo remote cache ---
# TURBO_TOKEN=
# TURBO_TEAM=
