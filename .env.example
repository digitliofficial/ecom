# --- Database (Nest / FastAPI / workers) ---
# Use ecom_app (non-superuser) so Postgres RLS applies. Owner/superuser bypasses RLS.
DATABASE_URL=postgresql://ecom_app:ecom@localhost:5432/ecom
# Optional owner URL for migrations / break-glass
DATABASE_URL_ADMIN=postgresql://ecom:ecom@localhost:5432/ecom

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Required in production. Local/dev falls back to a fixed demo secret if empty.
JWT_SECRET=ecom-local-dev-jwt-secret-change-me

# --- Public URLs ---
# Storefront default: http://localhost:3005 (see apps/storefront package.json)
NEXT_PUBLIC_API_URL=http://localhost:3001
COMPUTE_URL=http://localhost:8000
DEFAULT_REGION=us
# CNAME target merchants point custom domains at (CDN/WAF edge; stub for local)
PLATFORM_CNAME_TARGET=edge.ecom.digitli.local

# --- Stripe (commerce — PaymentProvider / Connect) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (SaaS Billing — merchant subscriptions) ---
STRIPE_BILLING_SECRET_KEY=

# --- Email (console MVP; Resend optional) ---
# EMAIL_PROVIDER=console|resend — default: console, or resend when RESEND_API_KEY is set
EMAIL_PROVIDER=console
EMAIL_FROM=Ecom <noreply@localhost>
RESEND_API_KEY=
# Storefront base for abandoned-cart resume links
STOREFRONT_URL=http://localhost:3005
# Set to 0 to disable in-process outbox/abandon poller
# NOTIFICATIONS_WORKER=1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=

# --- Platform ops (migration UI / CLI / worker-migrate) ---
PLATFORM_API_KEY=ecom-local-platform-key-change-me
# Optional browser-exposed copy for platform-admin local only — prefer server env
# NEXT_PUBLIC_PLATFORM_API_KEY=

# --- Shopify migration (per-merchant later → vault) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Per-job Admin API tokens are passed at create time (not stored after run).

# --- Address / courier adapters ---
ADDRESS_VALIDATION_API_KEY=
COURIER_API_KEY=

# --- Optional Turbo remote cache ---
# TURBO_TOKEN=
# TURBO_TEAM=
